# Copy to .env and fill in real values. .env is gitignored; this file is not.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# Optional — LLM personalisation. Leave blank; llm_personalise() falls back to templates.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional — error monitoring. Empty = Sentry disabled (sentry_sdk.init is a no-op).
SENTRY_DSN=

# Optional — WhatsApp Cloud API for payment-received notifications.
# Leave unset to skip notifications silently.
WA_TOKEN=
WA_PHONE_ID=
WA_RECIPIENT=
